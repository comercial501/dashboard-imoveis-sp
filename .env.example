# Copie este arquivo para ".env" (mesma pasta) e preencha o token real.
# O arquivo ".env" nunca deve ser commitado — já está no .gitignore.

# Token da API da nonStop — pegue em:
# https://www.usenonstop.com/configuracoes?tab=integration (seção Integrações)
# Sem isso definido, build_data.py cai automaticamente para o export manual
# em dados-usenonstop/*.xlsx (se existir algum arquivo lá).
NONSTOP_TOKEN=
