# Copie este arquivo para ".env" (mesma pasta) e preencha o token real.
# O arquivo ".env" nunca deve ser commitado — já está no .gitignore.

# Token da API da nonStop — pegue em:
# https://www.usenonstop.com/configuracoes?tab=integration (seção Integrações)
# Sem isso definido, build_data.py cai automaticamente para o export manual
# em dados-usenonstop/*.xlsx (se existir algum arquivo lá).
NONSTOP_TOKEN=

# Interesse de busca no Google (Keyword Planner) por bairro — OPCIONAL, a
# dashboard funciona normalmente sem isso (só não mostra o selo "Busca:
# Alto/Médio/Baixo" no Ranking e na Prontidão). Setup: ver README.md
# ("Interesse de busca"). O refresh token é gerado uma vez, localmente, com
# `python3 scripts/generate_refresh_token.py` (nunca rode isso no CI).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
